# =====================================================================
# .env.example
# Plantilla de variables de entorno para la API eqd.
# En el VPS, colocar en: /etc/eqd-api/env (dueño root:eqd, permisos 640)
# =====================================================================

NODE_ENV=production
PORT=3000

# Conexión local restringida a PostgreSQL
DATABASE_URL=postgresql://eqd_app:TU_PASSWORD_GENERADA_AQUI@127.0.0.1:5432/eqd?sslmode=disable

# Orígenes CORS permitidos (separados por coma si hay múltiples)
# En desarrollo: http://localhost:8080,http://127.0.0.1:8080
# En producción: https://jonnsix05.github.io
CORS_ORIGIN=https://jonnsix05.github.io

# Nivel de logs (error, warn, info, debug)
LOG_LEVEL=info

# URL pública del frontend para enlaces de recuperación de contraseña
PUBLIC_APP_URL=https://jonnsix05.github.io/ecuaciones-quiz

# Configuración SMTP para recuperación de contraseña (ej. Gmail con Contraseña de Aplicación)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=xxxx_xxxx_xxxx_xxxx
SMTP_FROM="Ecuaciones Diferenciales <tu_correo@gmail.com>"

